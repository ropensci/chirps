area = ext(c(-66, -64, -6, -4))
r5 = get_chirps(area, dates)

# Case 6: total rainfall per polygon and day
r6 = get_chirps(v, dates, as.raster = FALSE, operation = 4)

# Case 7: rainfall indices with climatrends
